{
  "name": "gost-kit-functional-core-example",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^26.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run format:check && npm run check:code",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "fix": "npm run lint:fix && npm run format",
    "check:code": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit && npm test"
  },
  "dependencies": {
    "svelte": "5.57.2",
    "@gost-kit/common": "file:../../packages/common",
    "@gost-kit/svelte": "file:../../packages/svelte"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "26.6.5",
    "svelte-check": "4.7.7",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "@gost-kit/eslint-config": "file:../../packages/eslint-config",
    "@gost-kit/prettier-config": "file:../../packages/prettier-config",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "globals": "17.4.0",
    "eslint-plugin-svelte": "3.24.0",
    "prettier-plugin-svelte": "4.1.1",
    "typescript-eslint": "8.72.1"
  }
}
