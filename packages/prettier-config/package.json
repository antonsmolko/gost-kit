{
  "name": "@gost-kit/prettier-config",
  "version": "0.1.0",
  "description": "Framework-independent shared Prettier configuration.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^26.0.0"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/prettier.config.d.ts",
      "import": "./dist/prettier.config.js",
      "default": "./dist/prettier.config.js"
    }
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepack": "npm run build",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antonsmolko/gost-kit.git",
    "directory": "packages/prettier-config"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "5.9.3",
    "tsc-alias": "1.9.9",
    "vitest": "5.0.5",
    "prettier": "3.9.10"
  },
  "peerDependencies": {
    "prettier": "^3.9.10"
  }
}
