{
  "name": "@gost-kit/eslint-config",
  "version": "0.0.0",
  "description": "Framework-independent shared ESLint rules.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^26.0.0"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "RULES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepack": "npm run build",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antonsmolko/gost-kit.git",
    "directory": "packages/eslint-config"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "5.9.3",
    "tsc-alias": "1.9.9",
    "vitest": "5.0.5",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "@gost-kit/prettier-config": "0.0.0",
    "globals": "17.4.0",
    "@gost-kit/common": "0.1.0"
  },
  "dependencies": {
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@typescript-eslint/utils": "8.72.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-node": "0.4.0",
    "eslint-plugin-import-x": "4.17.1",
    "typescript-eslint": "8.72.1"
  },
  "peerDependencies": {
    "eslint": "^10.14.0",
    "typescript": "^5.9.3"
  }
}
