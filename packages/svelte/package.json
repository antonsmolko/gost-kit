{
  "name": "@gost-kit/svelte",
  "version": "0.1.0",
  "description": "Svelte bindings for GOST functional core.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^26.0.0"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "svelte-package -i src && tsc-alias -p tsconfig.json --outDir dist && node scripts/clean-build.ts",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@gost-kit/common": "^0.1.0"
  },
  "peerDependencies": {
    "svelte": "^5.57.2"
  },
  "devDependencies": {
    "@sveltejs/package": "3.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "26.6.5",
    "svelte": "5.57.2",
    "tsc-alias": "1.9.9",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antonsmolko/gost-kit.git",
    "directory": "packages/svelte"
  },
  "homepage": "https://github.com/antonsmolko/gost-kit/tree/main/packages/svelte#readme",
  "bugs": {
    "url": "https://github.com/antonsmolko/gost-kit/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
